{
  "name": "geochatbot",
  "version": "0.0.1",
  "private": true,
  "description": "Embeddable chatbot widget for in-browser spatial and tabular data analysis.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*",
    "e2e"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@geochatbot/widget",
    "demo": "npm run dev --workspace=@geochatbot/demo",
    "build": "npm run build --workspaces --if-present",
    "build:widget": "npm run build --workspace=@geochatbot/widget",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "e2e": "npm run test:e2e --workspace=@geochatbot/e2e",
    "e2e:install": "npm run test:install --workspace=@geochatbot/e2e",
    "hello": "echo \"GeoChatBot widget v0.0.0\""
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
