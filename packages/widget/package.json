{
  "name": "@geochatbot/widget",
  "version": "0.0.1",
  "description": "GeoChatBot embeddable Web Component.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/geochatbot.umd.cjs",
  "module": "./dist/geochatbot.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/geochatbot.js",
      "require": "./dist/geochatbot.umd.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:size": "du -h dist/geochatbot.js dist/geochatbot.umd.cjs && printf 'gzipped ESM: %s bytes\\n' \"$(gzip -c dist/geochatbot.js | wc -c | tr -d ' ')\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.29.0",
    "@loaders.gl/arrow": "^4.3.0",
    "@loaders.gl/core": "^4.3.0",
    "@loaders.gl/csv": "^4.3.0",
    "@loaders.gl/excel": "^4.3.0",
    "@loaders.gl/gis": "^4.3.0",
    "@loaders.gl/json": "^4.3.0",
    "@loaders.gl/parquet": "^4.3.0",
    "@loaders.gl/shapefile": "^4.3.0",
    "@deck.gl/core": "^9.0.30",
    "@deck.gl/layers": "^9.0.30",
    "@deck.gl/mapbox": "^9.0.30",
    "apache-arrow": "^17.0.0",
    "jszip": "^3.10.1",
    "lit": "^3.2.0",
    "maplibre-gl": "^4.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "happy-dom": "^15.11.6",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.5"
  }
}
